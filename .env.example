# Deep work. This is the official DeepSeek route DeepSeek Harness calls deepseek-official.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MARKETING_DSH_MODEL=deepseek-v4-flash

# Everyday copy. Direct Ollama Cloud — Vercel has no local Ollama daemon.
# gemma4 is the cheap draft. qwen3.5 is the better low-cost model.
# Do not default to deepseek-v4-pro:cloud; that one costs more.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
MARKETING_OLLAMA_MODEL=gemma4:31b-cloud
MARKETING_OLLAMA_QUALITY_MODEL=qwen3.5:cloud
